# Configuration NON SENSIBLE du déploiement (versionnée dans Git).
# Les mots de passe et clés sont dans secrets.env (non versionné, généré par Jenkins).

# Images Docker Hub : <IMAGE_PREFIX><service>:<TAG>
IMAGE_PREFIX=seckou04/jangalma-
FRONTEND_TAG=latest
BACKEND_TAG=latest

# Port d'accès à l'application : http://localhost:8088
APP_PORT=8088

# Base de données (le mot de passe est dans secrets.env)
DB_USERNAME=jangalma_app

# JWT
JWT_ISSUER=uadb-platform

# MinIO (le mot de passe est dans secrets.env)
MINIO_ROOT_USER=jangalma_minio
MINIO_BUCKET=uadb-ressources

# Modèle des SECRETS du déploiement. Copier en secrets.env et remplacer les valeurs.
# secrets.env n'est JAMAIS versionné (voir .gitignore) : en CD, Jenkins le génère depuis ses credentials.
#
# Générer des valeurs aléatoires (PowerShell ou Git Bash) :
#   JWT_SECRET       : openssl rand -base64 48
#   INTERNAL_API_KEY : openssl rand -hex 32

MYSQL_ROOT_PASSWORD=a-changer
DB_PASSWORD=a-changer
JWT_SECRET=a-changer-base64-au-moins-256-bits
INTERNAL_API_KEY=a-changer
MINIO_ROOT_PASSWORD=a-changer-8-caracteres-minimum
# Mot de passe de l'administrateur initial (8 caractères minimum)
BOOTSTRAP_ADMIN_PASSWORD=a-changer-8-caracteres-minimum

# Modèle des SECRETS du déploiement (noms des variables attendues).
# Le plus simple : générer secrets.env automatiquement avec des valeurs aléatoires :
#   powershell -ExecutionPolicy Bypass -File scripts\generer-secrets.ps1
# secrets.env n'est JAMAIS versionné (voir .gitignore). En CD, Jenkins le reçoit
# depuis son credential « jangalma-secrets-env » (type Secret file).
#
# Règles si vous le remplissez à la main : pas de $, #, espace ni guillemets dans les valeurs ;
#   JWT_SECRET : Base64 d'au moins 32 octets (ex. openssl rand -base64 48)

MYSQL_ROOT_PASSWORD=a-changer
DB_PASSWORD=a-changer
JWT_SECRET=a-changer-base64-au-moins-256-bits
INTERNAL_API_KEY=a-changer
MINIO_ROOT_PASSWORD=a-changer-8-caracteres-minimum
# Mot de passe de l'administrateur initial (8 caractères minimum)
BOOTSTRAP_ADMIN_PASSWORD=a-changer-8-caracteres-minimum
